{
  "name": "@x3-chain/transparency",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:data": "node ../../scripts/transparency/generate.mjs",
    "watch:data": "node scripts/watch-data.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:data && tsc --noEmit && vite build",
    "build:static": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.3.0",
    "vite": "^6.1.0"
  }
}
