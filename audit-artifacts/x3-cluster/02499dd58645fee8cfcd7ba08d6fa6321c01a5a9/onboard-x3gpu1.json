  "staged_privileged": "#!/usr/bin/env bash\n# Review, then run: bash /home/lojak/.config/x3-cluster/staged-privileged.sh\nset -euo pipefail\n\n# CUDA toolkit (needed to build the .cu kernels): install cuda-toolkit-12-8  # from NVIDIA's apt repo; CUDA 13 dropped Pascal (sm_61)\n\n# Stable-name fallback until DHCP reservations/DNS exist. Skips names already present.\ngrep -qw 'x3star1' /etc/hosts || echo '192.168.0.70 x3star1  # x3-cluster' | sudo tee -a /etc/hosts\n\n# Pin the system ollama.service to NVIDIA GeForce RTX 2060 SUPER (GPU-baea27c9-70a5-1025-e717-01005f5da6b0) on 0.0.0.0:11434\nsudo mkdir -p /etc/systemd/system/ollama.service.d\nsudo tee /etc/systemd/system/ollama.service.d/override.conf >/dev/null <<'EOF'\n[Service]\nEnvironment=\"CUDA_DEVICE_ORDER=PCI_BUS_ID\"\nEnvironment=\"CUDA_VISIBLE_DEVICES=GPU-baea27c9-70a5-1025-e717-01005f5da6b0\"\nEnvironment=\"OLLAMA_VULKAN=0\"\nEnvironment=\"GGML_VK_VISIBLE_DEVICES=\"\nEnvironment=\"OLLAMA_HOST=0.0.0.0:11434\"\nEnvironment=\"OLLAMA_SCHED_SPREAD=false\"\nEnvironment=\"OLLAMA_MAX_LOADED_MODELS=1\"\nEnvironment=\"OLLAMA_NUM_PARALLEL=1\"\nEnvironment=\"OLLAMA_CONTEXT_LENGTH=16384\"\nEnvironment=\"OLLAMA_FLASH_ATTENTION=1\"\nEnvironment=\"OLLAMA_KV_CACHE_TYPE=q8_0\"\nEnvironment=\"OLLAMA_KEEP_ALIVE=30m\"\nEOF\nsudo systemctl daemon-reload && sudo systemctl restart ollama.service\n\n# Firewall: LAN SSH, GPU workers only to the router/ops hosts. SSH is allowed before enabling.\nsudo ufw allow from 192.168.0.0/24 to any port 22 proto tcp\nsudo ufw allow from 192.168.0.70 to any port 11434 proto tcp\nsudo ufw allow from 192.168.0.70 to any port 11436 proto tcp\nsudo ufw --force enable && sudo ufw status numbered",
