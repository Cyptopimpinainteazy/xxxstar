risk_policy {
    min_route_score 90
}

intent simple_swap {
    from arbitrum.USDC amount 500
    to solana.SOL receiver wallet

    route {
        bridge X3 arbitrum.USDC -> solana.SOL receiver wallet
    }

    require nonce unused simple_swap_001
    require finality.arbitrum >= 32
    require finality.solana >= 32
    require slippage <= 50
    require route_score >= 90

    timeout 180s refund arbitrum.USDC to sender
    on_fail rollback
}

// The bridge above cannot be claimed on the far side without evidence that the
// source chain locked the funds and that the destination chain filled them.
// Those are this program's proof obligations, so it declares them rather than
// leaving the verifier to warn about each one.
proofs required {
    source_lock_proof
    destination_fill_proof
}
