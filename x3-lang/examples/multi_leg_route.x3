intent multi_leg_portfolio {
    from polygon.USDC amount 1000

    route {
        bridge X3 polygon.USDC -> arbitrum.USDC amount 400
        swap Uniswap polygon.USDC -> solana.SOL amount 300
        bridge X3 polygon.USDC -> sui.SUI amount 200
        bridge X3 polygon.USDC -> bitcoin.BTC amount 100
    }

    require nonce unused multi_leg_portfolio_001
    require finality.polygon >= 32
    require slippage <= 120
    require route_score >= 90

    timeout 600s refund polygon.USDC to sender
    on_fail rollback
}
