vm {
    chain arbitrum
    adapter evm
    finality safe
}

solver_market {
    mode competitive
    min_reputation 95
    bond 10_000 USDC
}

relayers {
    quorum_numerator 3
    quorum_denominator 5
    relayers [relayer_a, relayer_b, relayer_c, relayer_d, relayer_e]
}

rpc_quorum {
    source arbitrum
    require_numerator 2
    require_denominator 3
    reject_on [receipt_disagree, finality_disagree]
}

risk_policy {
    max_slippage 50
    max_position 500000
    min_route_score 90
}

privacy {
    hide_route_until_commit true
    reveal_on claim
    // `encrypted true` used to be written here. Nothing implements encryption —
    // the executor reads the flag as `encrypted: _` — so the line was a claim
    // of a guarantee the artifact could not keep, and the compiler now refuses
    // it. What is real is above: the route is committed to and revealed on
    // `claim`.
}

invariant no_double_claim

proofs required {
    source_lock_proof
    source_finality_proof
    destination_fill_proof
    destination_finality_proof
    solver_signature
    relayer_quorum
    rpc_quorum
}

finality_policy strict {
    chain ethereum
    requirement finalized
}

error SlippageExceeded

target evm {
    adapter evm_adapter
    contract 0x742d35Cc6634C0532925a3b844Bc9e7595f2bD18
}

intent deep_cross_vm_swap {
    from arbitrum.USDC amount 500
    to solana.SOL receiver wallet

    route {
        // Absolute floor for this leg; see the note in multi_leg_route.x3. A
        // swap with no floor is rejected by the structural IR verifier.
        swap Uniswap arbitrum.USDC -> arbitrum.WETH amount 500 min_output 400
        bridge X3 arbitrum.WETH -> solana.SOL amount 500 receiver wallet
    }

    require nonce unused flagship_001
    require slippage <= 50
    require route_score >= 90
    require finality.arbitrum >= 32
    require finality.solana >= 32
    require relayer_quorum >= 3
    require solver_bond >= 10000

    timeout 180s
    on_fail refund arbitrum.USDC to sender
}
