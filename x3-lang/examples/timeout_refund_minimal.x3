intent timeout_refund_minimal {
    from Ethereum.USDC amount 100 receiver 0x1111111111111111111111111111111111111111
    to Solana.USDC receiver 4Nd1mzi8Y1QYxJt9wZWBYZpG7S4pYkZs6YzD3Vt9aBcD
    route {
        bridge X3 Ethereum.USDC -> Solana.USDC receiver 4Nd1mzi8Y1QYxJt9wZWBYZpG7S4pYkZs6YzD3Vt9aBcD
    }
    require nonce unused timeout_refund_minimal_1
    require finality.ethereum >= 12
    timeout 45s refund Ethereum.USDC to sender
}

// The bridge above cannot be claimed on the far side without evidence that the
// source chain locked the funds and that the destination chain filled them.
// Those are this program's proof obligations, so it declares them rather than
// leaving the verifier to warn about each one.
proofs required {
    source_lock_proof
    destination_fill_proof
}
