// A **sketch**, not a program: element-wise vector arithmetic. See `README.md` beside this
// file. The dialect is the older one (`fn` bodies, `vec![…]` literals) that the parser does
// not accept, and the language has no surface syntax for a vector value yet — it has the
// `VECTOR_MATH` instruction and nothing that writes one (TICKET-014).
// Test: vector ops
fn main() {
    let a = vec![1,2,3,4];
    let b = vec![5,6,7,8];
    let c = a + b; // implies SIMD add
}
