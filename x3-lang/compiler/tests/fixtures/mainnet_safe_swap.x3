vm {
    chain ethereum
    adapter evm
    finality safe
}

solver_market {
    mode competitive
    min_reputation 95
    bond 10_000 USDC
}

relayers {
    quorum_numerator 3
    quorum_denominator 5
    relayers [relayer_a, relayer_b, relayer_c]
}

rpc_quorum {
    source ethereum
    require_numerator 2
    require_denominator 3
    reject_on [receipt_disagree]
}

// The bridge above cannot be claimed on the far side without evidence that the source chain
// locked the funds and that the destination filled them. The compiler requires both of a
// bridging program in mainnet mode; this fixture predated the rule.
proofs required {
    source_lock_proof
    destination_fill_proof
}

risk_policy {
    max_slippage 1
    max_position 500000
    // The floor the declaration's `require route_score >= 80` is checked against: a guard with
    // nothing to compare it to is refused, which this fixture did not state.
    min_route_score 80
}

finality_policy strict {
    chain ethereum
    requirement finalized
    blocks 12
}

finality_policy strict {
    chain solana
    requirement finalized
    blocks 32
}

intent mainnet_swap {
    from ethereum.USDC amount 1000 receiver 0x1111111111111111111111111111111111111111
    to solana.SOL receiver 0x5678

    route {
        bridge x3 ethereum.USDC -> solana.SOL amount 1000
    }

    // Replay protection, which a bridge requires and this fixture did not state.
    require nonce unused mainnet_swap_001
    require slippage <= 1
    require finality.ethereum >= 12
    require finality.solana >= 32
    require solver_bond >= 10000
    require relayer_quorum >= 3
    require route_score >= 80

    timeout 3600s refund ethereum.USDC to 0x1111111111111111111111111111111111111111
}
