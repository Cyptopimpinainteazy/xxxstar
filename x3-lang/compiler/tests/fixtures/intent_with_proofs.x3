// `proofs required` is a file-scope declaration: it records which proofs the
// program depends on. It used to be written inside the intent body, where the
// intent-clause parser did not recognise it and silently parsed it as an
// expression statement, so the declaration was accepted and never applied.
proofs required {
    source_lock_proof
    source_finality_proof
    destination_fill_proof
    destination_finality_proof
    solver_signature
}

intent proven_swap {
    from ethereum.USDC amount 1000 sender 0xsender
    to solana.SOL receiver 0xreceiver

    route {
        bridge x3 ethereum.USDC -> solana.SOL amount 1000
    }

    timeout 3600s
    on_fail refund sender 0xsender
}
