{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "X3 Intent",
  "type": "object",
  "required": ["intent", "from", "to", "path"],
  "properties": {
    "intent": {"type": "string"},
    "from": {
      "type": "object",
      "required": ["chain", "asset"],
      "properties": {
        "chain": {"type": "string"},
        "asset": {"type": "string"},
        "amount": {"type": ["string", "number", "null"]}
      }
    },
    "to": {
      "type": "object",
      "required": ["chain", "asset"],
      "properties": {
        "chain": {"type": "string"},
        "asset": {"type": "string"}
      }
    },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["swap", "bridge"]},
          "dex": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "via": {"type": "string"},
          "asset": {"type": "string"}
        },
        "required": ["type"]
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_profit": {"type": "string"},
        "max_slippage": {"type": "string"},
        "timeout": {"type": "string"},
        "atomic": {"type": "boolean"}
      }
    }
  }
}
