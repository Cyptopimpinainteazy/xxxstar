+    /// Ed25519 public key of the signing validator.
+    pub public_key: [u8; PUBLIC_KEY_LEN],
+    /// Ed25519 signature over `statement_hash`.
     pub signature: Vec<u8>,
+    /// Voting weight contributed once the attestation verifies.
     pub weight: u64,
