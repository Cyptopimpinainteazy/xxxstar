+/// Render an `H256` the way proof bundles carry a transaction id.
+fn hex32(value: H256) -> String {
+    let mut out = String::from("0x");
+    for byte in value.as_bytes() {
+        out.push_str(&format!("{byte:02x}"));
+    }
