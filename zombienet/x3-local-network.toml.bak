[relaychain]
default_command = "./target/release/x3-chain-node"
default_args = ["--execution", "native", "--no-prometheus"]
chain_spec_path = "/tmp/x3-chain-plain.json"

  [[relaychain.nodes]]
  name = "alice"
  validator = true
  args = ["--alice", "--port", "30333", "--rpc-port", "9944"]

  [[relaychain.nodes]]
  name = "bob"
  validator = true
  args = ["--bob", "--port", "30334", "--rpc-port", "9945"]

  [[relaychain.nodes]]
  name = "charlie"
  validator = true
  args = ["--charlie", "--port", "30335", "--rpc-port", "9946"]