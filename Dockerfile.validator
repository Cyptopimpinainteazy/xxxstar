# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.validator
#
# ⚠️  IMPORTANT: Docker is for DEV/TEST only.
# Mainnet validators MUST run directly from signed binaries via systemd.
# See packaging/systemd/ for production deployment.
#
# This Dockerfile is suitable for:
#   - Local devnet testing
#   - CI ephemeral test chains
#   - Controlled staging environments
#
# NOT suitable for:
#   - Public mainnet validators
#   - Public testnet validators in production
#
# For production: use scripts/install-validator.sh + packaging/systemd/
#
# Multi-stage build: compile from source OR use pre-built binary
# Usage: docker build -f Dockerfile.validator -t x3-chain-node:latest .
# ─────────────────────────────────────────────────────────────────────────────

ARG RUST_VERSION=1.90.0
ARG DEBIAN_VERSION=bookworm

# ── Stage 1: Builder (only used if building from source) ───────────────────
FROM rust:${RUST_VERSION}-slim-${DEBIAN_VERSION} as builder

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    cmake \
    git \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy source code
COPY . .

# Build x3-chain-node release binary
# Takes ~15 minutes on moderate hardware
RUN cargo build --release -p x3-chain-node \
    && ls -lh target/release/x3-chain-node

# ── Stage 2: Runtime Image ──────────────────────────────────────────────────
FROM ubuntu:24.04 as runtime

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for validator process
RUN useradd -m -u 2000 validator

WORKDIR /home/validator

# Copy compiled binary from builder stage
COPY --from=builder --chown=validator:validator /build/target/release/x3-chain-node /usr/local/bin/x3-chain-node

# Bundle chain spec into image
COPY --chown=validator:validator deployment/chain-specs/x3-testnet-raw.json /etc/x3/chain-spec.json

# Create data directory with proper permissions
RUN mkdir -p /home/validator/data && \
    chown -R validator:validator /home/validator/data /etc/x3

USER validator

# ── Health Check ─────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:9933 || exit 1

# ── Ports ────────────────────────────────────────────────────────────────
# 30333 - P2P peer discovery port
# 9933  - RPC endpoint
# 9616  - Prometheus metrics
EXPOSE 30333 9933 9616

# ── Default Command ──────────────────────────────────────────────────────
# Override with `docker run -e VALIDATOR_NAME=val-1 -e X3_BOOTNODES=… ...`
# Flags explained:
#   --chain: Chain specification file
#   --validator: Enable validator mode (block production)
#   --name: Human-readable validator name (used in logs/telemetry)
#   --base-path: Data directory for validator state
#   --rpc-port: RPC server port
#   --rpc-external: Bind RPC to 0.0.0.0 (safe inside container network)
#   --rpc-methods Safe: Only expose safe RPC methods in production
#   --prometheus-port: Metrics endpoint
#   --prometheus-external: Expose Prometheus metrics
#   --log: Logging level
#   --bootnodes: From X3_BOOTNODES; required, see below
#
# X3_BOOTNODES is required, and the check is in the command rather than in this
# comment because the bundled spec cannot carry the answer: the bootnodes that
# are missing are the deployment's, and inventing peer ids for
# deployment/chain-specs/x3-testnet-raw.json would be a lie. A validator that
# starts with no peers looks healthy and does nothing, which is the worst of the
# available failures — so this refuses to start instead.
#
#   docker run -e X3_BOOTNODES="/ip4/<host>/tcp/30333/p2p/<peerid>,…" …
#
# X3_CHAIN_SPEC overrides the bundled chain spec. Note that the bundled
# `x3-testnet-raw.json` is a Live *raw* spec, which the node refuses to load;
# mount a plain spec and set X3_CHAIN_SPEC for anything beyond inspection.
CMD ["sh", "-c", "if [ -z \"$X3_BOOTNODES\" ]; then echo 'X3_BOOTNODES is required (comma-separated multiaddrs); the bundled spec ships with an empty bootNodes list, so a node started without it would never find a peer' >&2; exit 2; fi; exec x3-chain-node --chain \"${X3_CHAIN_SPEC:-/etc/x3/chain-spec.json}\" --validator --name \"${VALIDATOR_NAME:-x3-validator}\" --base-path /home/validator/data --rpc-port 9933 --rpc-external --rpc-methods Safe --prometheus-port 9616 --prometheus-external --bootnodes \"$X3_BOOTNODES\" --log info"]

# ── Metadata ─────────────────────────────────────────────────────────────
LABEL org.opencontainers.image.title="X3 Chain Validator" \
      org.opencontainers.image.description="Substrate-based validator node for X3 blockchain" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.source="https://github.com/x3-chain/x3-atomic-star"
