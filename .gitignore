# Reproducible srtool build reports (transient output; the canonical record is
# docs/reports/runtime-wasm-hashes.json).
/.srtool-reports/
# Generated by scripts/mainnet/runtime_upgrade_rehearsal.sh; the gate greps the
# report for its verdict, so it is output, not a tracked artifact.
# The same for the drills and the public-testnet gate: each writes a report whose verdict
# describes the run that produced it, so it is output rather than a tracked artifact.
/reports/drill_node_restart.md
/reports/drill_validator_removal.md
/reports/public_testnet_gate.md
/reports/runtime_upgrade_rehearsal.md
/reports/runtime_upgrade_rehearsal/

# Local editor/agent tool configuration (not shared project config).
# Not root-anchored: these have turned up nested under other directories too
# (e.g. docs/reports/.cursor/, docs/reports/.ai-todo/) from accidental copies.
.cursor/
.gemini/
# Roo Code project MCP config carries machine-specific absolute paths (node
# binary, extension path, workspace path), exactly like .vscode/, .cursor/ and
# .gemini/ above. The portable half of the Roo guardrails is `.roo/rules/`,
# which is tracked; this file stays local so a clone does not inherit another
# machine's paths.
.roo/mcp.json
.todo
.ai-todo/
# The release gate's and the runtime attestation's shared build lock. It is
# process-scoped state, not evidence: it exists so a second run of either one
# refuses instead of racing the first through `runtime/target/srtool`.
.x3-release-build.lock

# Coq compiler output produced by the formal gate (`x3-proof formal` runs
# coqc, directly or via the tools/coqc docker fallback). These are build
# products, not evidence: the tracked source is SupplyInvariant.v, and the
# gate reruns coqc. Without these the gate dirties the tree and the next
# `git add -A` can commit stale proof objects.
formal-proofs/coq/*.vo
formal-proofs/coq/*.vok
formal-proofs/coq/*.vos
formal-proofs/coq/*.glob
formal-proofs/coq/.*.aux

# cargo-mutants output; the gate moves a previous run aside to mutants.out.old
mutants.out/
mutants.out.old/


# Referents that dangling tracked symlinks (or their tooling) can materialize
# as untracked files: an `npm install` under apps/x3-funding, a `dpkg-deb -x`
# of libprotobuf, or a local ralph checkout. local-ci's freshness touch uses
# `touch -h`, but ignoring the referents keeps `git status` clean (required by
# --publish-status) even when other tools create them. The symlinks stay
# tracked.
apps/x3-funding/node_modules
libproto_lib/usr/share/doc/libprotobuf23
/ralph

# Third-party agent skills installed from `skills-lock.json` (which is tracked and pins their
# sources and hashes). The installed copies are reproducible output; the repository's own skills
# under .agents/skills/ stay tracked.
/.agents/skills/web3-tools/
/.agents/skills/web3-dev/
/.agents/skills/web3-audit/
/.agents/skills/web3-solidity-audit-mcp/
/.agents/skills/web3d-integration-patterns/
/.agents/skills/audit-prep-assistant/
/.agents/skills/code-review/
/.agents/skills/code-exemplars-blueprint-generator/

# Foundry build output: regenerated by forge, never source.
/tests_core/security/out/
