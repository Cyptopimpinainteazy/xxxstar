# X3 Testnet Configuration
# Docker Compose environment variables for local testnet deployment

# Chain Configuration
CHAIN_NAME=x3_testnet_1
CHAIN_ID=x3_testnet_1
PROTOCOL_ID=x3t

# Network Configuration
VALIDATOR_1_PEER_ID=12D3KooWG3XYz8GuM xg4u7gJ8LKb9xNb2vJ9vK8lT3
VALIDATOR_2_PEER_ID=12D3KooWLmK2xT5yJ9vN4pQ1rS2tU3vW4xY5zA6bB7cC8dD9eE0
VALIDATOR_3_PEER_ID=12D3KooWP8qR3sT4uV5wX6yZ7aA8bB9cC0dD1eE2fF3gG4hH5iI6

# RPC Configuration
RPC_HOST=0.0.0.0
RPC_PORT=9944
WS_PORT=9933

# Metrics & Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=<set-a-local-password>

# Logging
RUST_LOG=info,x3_consensus_gpu=debug,x3_dex_pallet=debug,pallet_x3_wallet=debug

# Block Configuration
BLOCK_TIME_MILLIS=6000
EPOCH_DURATION=600
TARGET_BLOCK_SIZE=5242880

# Wallet Pallet Configuration
MAX_WALLETS_PER_ACCOUNT=10
MAX_MULTISIG_SIGNERS=50
MAX_CONTACTS=1000
HARDWARE_WALLET_SUPPORT=true
BIOMETRIC_VERIFICATION_REQUIRED=false

# DEX Configuration
DEX_MIN_LIQUIDITY=1000
DEX_SWAP_FEE_PERCENT=500
DEX_PROTOCOL_FEE_PERCENT=100
DEX_MAX_POOL_DEPTH=1000000

# GPU Consensus Configuration
GPU_JOBS_PER_BLOCK=100
GPU_TARGET_VALIDATOR_COUNT=50
GPU_JOB_DIFFICULTY=10000
GPU_POW_algorithm=sha256

# Test Wallet Configuration
TEST_WALLET_MNEMONIC=<set-a-local-test-mnemonic-never-a-real-one>
HARDWARE_WALLET_SIMULATOR_ENABLED=true
HARDWARE_WALLET_SIMULATOR_PORT=9999

# Storage Configuration
DATA_VOLUME=./data
PROMETHEUS_DATA_VOLUME=./data/prometheus
GRAFANA_DATA_VOLUME=./data/grafana

# Performance Tuning
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT_SECONDS=30
DATABASE_CACHE_MB=512

# Endpoints for Integration Testing
VALIDATOR_1_RPC=http://validator-1:9944
VALIDATOR_2_RPC=http://validator-2:9944
VALIDATOR_3_RPC=http://validator-3:9944
RPC_NODE_RPC=http://rpc-node:9944

# Testnet Features
ENABLE_SUDO=true
ENABLE_OFF_CHAIN_WORKER=true
ENABLE_BENCHMARKING=true
ENABLE_RUNTIME_BENCHMARKS=false

# Security Configuration (Testnet Only)
ALLOW_INSECURE_RPC_METHODS=true
ALLOW_UNSAFE_RPC_METHODS=true
DISABLE_SSL_VALIDATION=true
