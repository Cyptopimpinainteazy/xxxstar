[Unit]
Description=Ollama Worker B (GTX 1070, review/test/summarize)
After=network-online.target

[Service]
Type=simple
# Template: deploy/install.sh replaces @OLLAMA@ with the ollama binary on PATH.
ExecStart=@OLLAMA@ serve
# Pin by UUID: nvidia-smi and CUDA enumerate these two cards in opposite
# orders, so a bare index silently put this worker on the RTX 2060 SUPER.
Environment="CUDA_DEVICE_ORDER=PCI_BUS_ID"
Environment="CUDA_VISIBLE_DEVICES=GPU-e0897c2d-090a-da7b-5679-f5338c4f9f02"
# One slot per card: parallel slots multiply the KV cache, and the router
# spills a second concurrent request to the other GPU instead.
# Keep the Vulkan backend from picking up the card CUDA was told to ignore.
Environment="OLLAMA_VULKAN=0"
Environment="GGML_VK_VISIBLE_DEVICES="
Environment="OLLAMA_HOST=127.0.0.1:11436"
Environment="OLLAMA_MODELS=%h/.ollama-worker-b/models"
Environment="OLLAMA_SCHED_SPREAD=false"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_CONTEXT_LENGTH=16384"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
Environment="OLLAMA_KEEP_ALIVE=30m"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
