{
  "name": "x3-chain-wallet-integration-tests",
  "version": "1.0.0",
  "description": "Compatibility commands for the canonical tests/wallet-integration suites; no separate test fixtures live in this directory.",
  "private": true,
  "scripts": {
    "test": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test --",
    "test:metamask": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:metamask --",
    "test:phantom": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:phantom --",
    "test:e2e": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:e2e --",
    "test:e2e:metamask": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:e2e:metamask --",
    "test:e2e:phantom": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:e2e:phantom --",
    "test:headed": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:headed --",
    "test:debug": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:debug --",
    "test:report": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run test:report --",
    "install:browsers": "npm --prefix ../../tests/wallet-integration ci --no-audit --no-fund && npm --prefix ../../tests/wallet-integration run install:browsers --"
  }
}
