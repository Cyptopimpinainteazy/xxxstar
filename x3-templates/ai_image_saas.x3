// ai_image_saas.x3 - AI Image/Video SaaS with GPU Job Credits, Generated Media Storage, User Subscriptions
//
// @version("1.0.0")
// @audit

contract AIImageSaaS {
    // Configuration constants
    const PLATFORM_FEE_BPS: u256 = 200;         // 2% platform fee
    const CREDIT_PRICE: u256 = 0.01 ether;      // Price per credit
    const GPU_COST_PER_SECOND: u256 = 10;       // Credits per GPU second
    const MAX_GENERATION_SIZE: u256 = 100;      // Max images per batch
    const STORAGE_FEE_PER_FILE: u256 = 1;       // Credits per stored file
    const FREE_CREDITS: u256 = 5;               // Free credits on signup

    // Storage
    address owner;
    mapping(address => UserAccount) users;
    mapping(u256 => GenerationJob) jobs;
    mapping(u256 => MediaFile) media_files;
    mapping(address => Subscription) subscriptions;
    u256 job_counter;
    u256 file_counter;
    u256 total_credits_sold;

    // Structs
    struct UserAccount {
        address user;
        u256 credit_balance;
        u256 total_credits_purchased;
        u256 total_credits_consumed;
        u256 created_at;
        bool exists;
    }

    struct GenerationJob {
        u256 id;
        address user;
        string prompt;
        string model;
        u256 image_count;
        u256 gpu_time_estimate;
        u256 credit_cost;
        string status;  // queued, processing, completed, failed
        u256 created_at;
        u256 completed_at;
        string[] output_files;
    }

    struct MediaFile {
        u256 id;
        address owner;
        string ipfs_hash;
        string content_type;
        u256 file_size;
        u256 created_at;
        bool public_access;
    }

    struct Subscription {
        address user;
        string tier;       // free, basic, pro, enterprise
        u256 monthly_credits;
        u256 used_credits;
        u256 renewal_time;
        bool active;
    }

    // Events
    event CreditsPurchased(address indexed user, u256 amount, u256 cost);
    event ImageGenerated(u256 indexed job_id, address indexed user, string prompt, u256 count);
    event CreditConsumed(address indexed user, u256 amount, string reason);
    event MediaStored(u256 indexed file_id, address indexed owner, string ipfs_hash);
    event SubscriptionUpdated(address indexed user, string tier, u256 monthly_credits);
    event PlatformFeeCollected(u256 amount);

    // Constructor
    fn constructor() {
        owner = msg.sender;
    }

    // ===== PURCHASE CREDITS =====

    fn purchase_credits(amount: u256) -> u256 {
        require(amount > 0, "Amount must be > 0");
        let cost = amount * CREDIT_PRICE;
        require(msg.value >= cost, "Insufficient payment");

        if !users[msg.sender].exists {
            users[msg.sender] = UserAccount {
                user: msg.sender,
                credit_balance: FREE_CREDITS + amount,
                total_credits_purchased: amount,
                total_credits_consumed: 0,
                created_at: block.timestamp,
                exists: true,
            };
        } else {
            users[msg.sender].credit_balance = users[msg.sender].credit_balance + amount;
            users[msg.sender].total_credits_purchased = users[msg.sender].total_credits_purchased + amount;
        }

        total_credits_sold = total_credits_sold + amount;

        // Collect platform fee
        let fee = cost * PLATFORM_FEE_BPS / 10000;
        transfer(owner, fee);
        emit PlatformFeeCollected(fee);

        emit CreditsPurchased(msg.sender, amount, cost);
        return users[msg.sender].credit_balance;
    }

    // ===== GENERATE IMAGE =====

    fn generate_image(prompt: string, model: string, image_count: u256) -> u256 {
        require(image_count > 0, "At least 1 image");
        require(image_count <= MAX_GENERATION_SIZE, "Batch too large");
        require(users[msg.sender].exists, "User not registered");

        // Estimate GPU time and credit cost
        let gpu_time = image_count * 30; // 30 seconds per image
        let credit_cost = gpu_time * GPU_COST_PER_SECOND;
        require(users[msg.sender].credit_balance >= credit_cost, "Insufficient credits");

        // Consume credits
        users[msg.sender].credit_balance = users[msg.sender].credit_balance - credit_cost;
        users[msg.sender].total_credits_consumed = users[msg.sender].total_credits_consumed + credit_cost;

        job_counter = job_counter + 1;
        jobs[job_counter] = GenerationJob {
            id: job_counter,
            user: msg.sender,
            prompt: prompt,
            model: model,
            image_count: image_count,
            gpu_time_estimate: gpu_time,
            credit_cost: credit_cost,
            status: "queued",
            created_at: block.timestamp,
            completed_at: 0,
            output_files: [],
        };

        emit ImageGenerated(job_counter, msg.sender, prompt, image_count);
        emit CreditConsumed(msg.sender, credit_cost, "image_generation");
        return job_counter;
    }

    fn complete_job(job_id: u256, output_hashes: string[]) {
        require(msg.sender == owner, "Only owner");
        let job = jobs[job_id];
        require(job.status == "queued" || job.status == "processing", "Invalid status");

        jobs[job_id].status = "completed";
        jobs[job_id].completed_at = block.timestamp;
        jobs[job_id].output_files = output_hashes;

        // Store media files
        for hash in output_hashes {
            file_counter = file_counter + 1;
            media_files[file_counter] = MediaFile {
                id: file_counter,
                owner: job.user,
                ipfs_hash: hash,
                content_type: "image/png",
                file_size: 0,
                created_at: block.timestamp,
                public_access: true,
            };
            emit MediaStored(file_counter, job.user, hash);
        }
    }

    // ===== CONSUME CREDIT =====

    fn consume_credit(amount: u256, reason: string) -> bool {
        require(users[msg.sender].exists, "User not found");
        require(users[msg.sender].credit_balance >= amount, "Insufficient credits");

        users[msg.sender].credit_balance = users[msg.sender].credit_balance - amount;
        users[msg.sender].total_credits_consumed = users[msg.sender].total_credits_consumed + amount;

        emit CreditConsumed(msg.sender, amount, reason);
        return true;
    }

    fn get_credit_balance(user: address) -> u256 {
        if !users[user].exists {
            return 0;
        }
        return users[user].credit_balance;
    }

    // ===== GET GENERATION HISTORY =====

    fn get_generation_history(user: address) -> GenerationJob[] {
        let user_jobs: GenerationJob[] = [];
        for i in 1..job_counter + 1 {
            if jobs[i].user == user {
                user_jobs.push(jobs[i]);
            }
        }
        return user_jobs;
    }

    fn get_job(job_id: u256) -> GenerationJob {
        return jobs[job_id];
    }

    fn get_media_file(file_id: u256) -> MediaFile {
        return media_files[file_id];
    }

    // ===== SUBSCRIPTION MANAGEMENT =====

    fn subscribe_tier(tier: string) {
        let monthly_credits: u256;
        let cost: u256;

        if tier == "basic" {
            monthly_credits = 100;
            cost = 1 ether;
        } else if tier == "pro" {
            monthly_credits = 500;
            cost = 5 ether;
        } else if tier == "enterprise" {
            monthly_credits = 2000;
            cost = 20 ether;
        } else {
            require(false, "Invalid tier");
        }

        require(msg.value >= cost, "Insufficient payment");

        subscriptions[msg.sender] = Subscription {
            user: msg.sender,
            tier: tier,
            monthly_credits: monthly_credits,
            used_credits: 0,
            renewal_time: block.timestamp + 2592000, // 30 days
            active: true,
        };

        // Add monthly credits to balance
        if !users[msg.sender].exists {
            users[msg.sender] = UserAccount {
                user: msg.sender,
                credit_balance: monthly_credits,
                total_credits_purchased: 0,
                total_credits_consumed: 0,
                created_at: block.timestamp,
                exists: true,
            };
        } else {
            users[msg.sender].credit_balance = users[msg.sender].credit_balance + monthly_credits;
        }

        let fee = cost * PLATFORM_FEE_BPS / 10000;
        transfer(owner, fee);

        emit SubscriptionUpdated(msg.sender, tier, monthly_credits);
    }

    // ===== PLATFORM FEE =====

    fn platform_fee(amount: u256) -> u256 {
        return amount * PLATFORM_FEE_BPS / 10000;
    }

    fn set_platform_fee_bps(new_fee_bps: u256) {
        require(msg.sender == owner, "Only owner");
        require(new_fee_bps <= 1000, "Max 10%");
        // Note: PLATFORM_FEE_BPS is const, this is a placeholder for upgrade
    }

    // ===== ADMIN =====

    fn credit_user(user: address, amount: u256) {
        require(msg.sender == owner, "Only owner");
        if !users[user].exists {
            users[user] = UserAccount {
                user: user,
                credit_balance: amount,
                total_credits_purchased: 0,
                total_credits_consumed: 0,
                created_at: block.timestamp,
                exists: true,
            };
        } else {
            users[user].credit_balance = users[user].credit_balance + amount;
        }
    }

    fn get_user_account(user: address) -> UserAccount {
        return users[user];
    }

    fn get_total_credits_sold() -> u256 {
        return total_credits_sold;
    }
}
