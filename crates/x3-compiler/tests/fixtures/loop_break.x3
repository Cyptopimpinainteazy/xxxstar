// A `loop` with a `break`: 1+2+3+4+5+6 = 21, stopping at i > 6
fn count_to(limit: i64) -> i64 {
    let mut i = 0;
    let mut total = 0;
    loop {
        i = i + 1;
        if (i > limit) {
            break;
        }
        total = total + i;
    }
    return total;
}

fn main() -> i64 {
    return count_to(6);
}
