// A `continue`: sum 1..=5 except 3, so 1+2+4+5 = 12
fn sum_except(n: i64, skip: i64) -> i64 {
    let mut i = 0;
    let mut total = 0;
    loop {
        i = i + 1;
        if (i > n) {
            break;
        }
        if (i == skip) {
            continue;
        }
        total = total + i;
    }
    return total;
}

fn main() -> i64 {
    return sum_except(5, 3);
}
